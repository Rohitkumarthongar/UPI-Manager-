{
  "hosting": {
    "public": "public",
    "headers": [
      {
        "source": "/version.json",
        "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk"
    ]
  }
}
